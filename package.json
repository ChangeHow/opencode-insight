{
  "name": "opencode-token-dashboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:bff": "cd apps/bff && pnpm dev",
    "stop:web": "node ./scripts/stop-port.mjs 3000 'frontend' WEB_PORT",
    "stop:bff": "node ./scripts/stop-port.mjs 8787 'BFF' PORT",
    "restart:web": "pnpm stop:web && pnpm dev:web",
    "restart:bff": "pnpm stop:bff && pnpm dev:bff",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "daemon:start": "node ./scripts/daemon.mjs",
    "daemon:stop": "node ./scripts/stop-daemon.mjs",
    "daemon:restart": "node ./scripts/stop-daemon.mjs && node ./scripts/daemon.mjs",
    "upgrade:app": "node ./scripts/upgrade.mjs",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0"
  }
}
