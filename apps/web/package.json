{
  "name": "@opencode-dashboard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/check-port.mjs 3000 'frontend' WEB_PORT",
    "dev": "PROCESS_TITLE=opencode-telescope-client NODE_OPTIONS='--require=../../scripts/set-process-title.cjs' vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@evilmartians/agent-prism-data": "^0.0.9",
