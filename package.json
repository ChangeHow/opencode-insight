{
  "name": "@changehow/oc-insight",
  "version": "1.2.1",
  "description": "Local-first token usage dashboard for OpenCode sessions.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChangeHow/opencode-insight.git"
  },
  "bin": {
    "opendash": "scripts/opendash.mjs"
  },
  "files": [
    "apps/bff/dist",
    "apps/web/dist",
    "scripts/opendash.mjs",
    "scripts/opendash-query.mjs",
    "scripts/opendash-extensions.mjs",
    "dist/opencode-rpc.js",
    "server.js",
    "openchamber/index.js",
    "openchamber/package.json",
    "openchamber/panel",
    "openchamber/service",
    "openchamber/opencode",
    "docs/v2-insight.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./opencode": "./server.js",
    "./server": "./server.js",
    "./rpc": "./dist/opencode-rpc.js",
    "./opencode/rpc": "./dist/opencode-rpc.js",
    "./openchamber": "./openchamber/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:bff": "cd apps/bff && pnpm dev",
    "stop:web": "node ./scripts/stop-port.mjs 3000 'frontend' WEB_PORT",
    "stop:bff": "node ./scripts/stop-port.mjs 8787 'BFF' PORT",
    "restart:web": "pnpm stop:web && pnpm dev:web",
    "restart:bff": "pnpm stop:bff && pnpm dev:bff",
    "build": "pnpm -r build",
    "postbuild": "node scripts/build-extension-exports.ts",
    "build:extensions": "pnpm --filter @changehow/opencode-insight-plugin --filter @changehow/openchamber-insight build && node scripts/build-extension-exports.ts",
    "test:extensions": "pnpm --filter @opencode-insight/telemetry --filter @opencode-insight/client --filter @changehow/opencode-insight-plugin --filter @changehow/openchamber-insight test",
    "smoke:extensions": "node scripts/smoke-v2-extensions.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.extensions.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "react-doctor apps/web -y --score --blocking warning",
    "bench": "pnpm -r --if-present bench",
    "bench:insight-memory": "node scripts/insight-memory/run.mjs",
    "daemon:start": "node ./scripts/daemon.mjs",
    "daemon:stop": "node ./scripts/stop-daemon.mjs",
    "daemon:restart": "node ./scripts/stop-daemon.mjs && node ./scripts/daemon.mjs",
    "upgrade:app": "node ./scripts/upgrade.mjs",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "check:node": "node ./scripts/check-node.mjs",
    "changeset": "changeset",
    "prepare": "node ./scripts/check-node.mjs && husky",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0",
    "@hono/node-server": "^1.14.4",
    "@opencode/plugin": "2.0.26",
    "commander": "^14.0.3",
    "dotenv": "^17.2.2",
    "hono": "^4.7.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@opencode-dashboard/shared": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.5.2",
    "esbuild": "^0.27.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "react-doctor": "0.7.4",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --quiet",
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
