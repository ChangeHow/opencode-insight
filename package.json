{
  "name": "opencode-token-dashboard",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "opendash": "./scripts/opendash.mjs"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:bff": "cd apps/bff && pnpm dev",
    "stop:web": "node ./scripts/stop-port.mjs 3000 'frontend' WEB_PORT",
    "stop:bff": "node ./scripts/stop-port.mjs 8787 'BFF' PORT",
    "restart:web": "pnpm stop:web && pnpm dev:web",
    "restart:bff": "pnpm stop:bff && pnpm dev:bff",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "daemon:start": "node ./scripts/daemon.mjs",
    "daemon:stop": "node ./scripts/stop-daemon.mjs",
    "daemon:restart": "node ./scripts/stop-daemon.mjs && node ./scripts/daemon.mjs",
    "upgrade:app": "node ./scripts/upgrade.mjs",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --quiet",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
